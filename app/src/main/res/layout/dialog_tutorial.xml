<?xml version="1.0" encoding="utf-8"?>
<!-- Asked after a new bunker is named (MainActivity): play the tutorial or skip it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/np_panel"
    android:orientation="vertical">

    <TextView
        style="@style/BunkerHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/tutorial_title" />

    <TextView
        style="@style/BunkerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/tutorial_question" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tutorialNo"
            style="@style/BunkerButton.Dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/tutorial_no" />

        <Button
            android:id="@+id/tutorialYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tutorial_yes" />
    </LinearLayout>
</LinearLayout>
