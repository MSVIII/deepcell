<?xml version="1.0" encoding="utf-8"?>
<!--
    Game screen, top to bottom (matches the group sketch):
    HUD, surface (sky with enemies + our bunker), underground rooms, bottom tabs.
    The upgrade sheet slides up over the rooms when a tab is selected.
    Scene art is Blender renders (drawable-nodpi); panels are 9-patches (drawable-xxhdpi).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- HUD: resources left, wave in the middle, settings right. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_hud"
        android:paddingStart="10dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:id="@+id/hudScrapGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/scrap"
                android:src="@drawable/icon_scrap" />

            <TextView
                android:id="@+id/hudScrap"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/hudScrapGroup"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/food"
                android:src="@drawable/icon_food" />

            <TextView
                android:id="@+id/hudFood"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_centerInParent="true"
            android:background="@drawable/np_pill"
            android:gravity="center"
            android:minWidth="96dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hudBossIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/boss_wave"
                android:src="@drawable/ic_skull"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hudWave"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_settings" />
    </RelativeLayout>

    <!-- Surface: rendered sky and ruins, our bunker on the ground. -->
    <FrameLayout
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_vignette" />

        <!-- Our bunker. Tap it to repair the hatch. -->
        <FrameLayout
            android:id="@+id/bunker"
            android:layout_width="@dimen/bunker_width"
            android:layout_height="@dimen/bunker_height"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/bunker">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/bunker" />

            <!--
                Survivors on roof guard duty, standing on the deck. GameActivity places them at
                fixed spots either side of the hatch (fractions of the bunker image).
            -->
            <FrameLayout
                android:id="@+id/roofCrew"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false" />
        </FrameLayout>

        <!--
            Enemy layer. Enemy ImageViews are added here and moved by the Handler loop.
            The bottom margin puts its bottom edge at the bunker hatch, where enemies hit.
        -->
        <FrameLayout
            android:id="@+id/sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="84dp" />

        <!-- Explosions and sparks play here, above the enemies and the bunker. -->
        <FrameLayout
            android:id="@+id/fxLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bunker name and hatch health, top-left; last so enemies fly behind it. -->
        <LinearLayout
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/np_label"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hatchText"
                style="@style/SceneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false" />

            <ProgressBar
                android:id="@+id/hatchBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:progressDrawable="@drawable/progress_hatch" />
        </LinearLayout>
    </FrameLayout>

    <!-- Underground: rooms in a ListView, with the upgrade sheet on top. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <ListView
            android:id="@+id/floorList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bedrock"
            android:divider="@null"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/upgradeSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/np_sheet"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <TextView
                    android:id="@+id/upgradeTitle"
                    style="@style/BunkerHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp" />

                <ImageButton
                    android:id="@+id/upgradeClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/close"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </RelativeLayout>

            <ListView
                android:id="@+id/upgradeList"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:divider="#338FA3B0"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="none" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom bar: 4 round tab slots. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tabbar"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tabDefense"
            style="@style/TabButton"
            android:contentDescription="@string/tab_defense"
            android:src="@drawable/icon_tab_defense" />

        <ImageButton
            android:id="@+id/tabSupplies"
            style="@style/TabButton"
            android:contentDescription="@string/tab_supplies"
            android:src="@drawable/icon_tab_supplies" />

        <ImageButton
            android:id="@+id/tabAutomation"
            style="@style/TabButton"
            android:contentDescription="@string/tab_automation"
            android:src="@drawable/icon_tab_automation" />

        <ImageButton
            android:id="@+id/tabSurvivors"
            style="@style/TabButton"
            android:contentDescription="@string/tab_survivors"
            android:src="@drawable/icon_tab_survivors" />
    </LinearLayout>
</LinearLayout>
