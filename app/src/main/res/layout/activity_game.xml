<?xml version="1.0" encoding="utf-8"?>
<!--
    Game screen, top to bottom (matches the group sketch):
    HUD, surface (sky with enemies + our bunker), underground rooms, bottom tabs.
    The upgrade sheet slides up over the rooms when a tab is selected.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- HUD: RelativeLayout so the gear sits on the right edge. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_hud"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/hudScrapChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/scrap"
                android:src="@drawable/ic_scrap" />

            <TextView
                android:id="@+id/hudScrap"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/hudScrapChip"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/food"
                android:src="@drawable/ic_food" />

            <TextView
                android:id="@+id/hudFood"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/settingsButton"
            android:background="@drawable/bg_wave_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/hudBossIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/boss_wave"
                android:src="@drawable/ic_skull"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hudWave"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </RelativeLayout>

    <!-- Surface: storm sky, ruined skyline, our bunker on the ground. -->
    <FrameLayout
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:background="@drawable/bg_sky">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_skyline" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_ground_edge" />

        <!-- Our bunker. Tap it to repair the hatch. -->
        <FrameLayout
            android:id="@+id/bunker"
            android:layout_width="@dimen/bunker_width"
            android:layout_height="@dimen/bunker_height"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/bunker">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bunker" />

            <!-- Survivors on roof guard duty are added here in code. -->
            <LinearLayout
                android:id="@+id/roofCrew"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- Hatch health, top-left of the surface. -->
        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_label"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/hatchText"
                style="@style/BunkerSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main" />

            <ProgressBar
                android:id="@+id/hatchBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="3dp"
                android:progressDrawable="@drawable/progress_hatch" />
        </LinearLayout>

        <!--
            Enemy layer. Enemy ImageViews are added here and moved by the Handler loop.
            The bottom margin puts its bottom edge at the bunker roof, where enemies hit.
        -->
        <FrameLayout
            android:id="@+id/sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="72dp" />
    </FrameLayout>

    <!-- Underground: rooms in a ListView, with the upgrade sheet on top. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <ListView
            android:id="@+id/floorList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bedrock"
            android:divider="@null"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/upgradeSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/upgradeTitle"
                    style="@style/BunkerHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true" />

                <ImageButton
                    android:id="@+id/upgradeClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/close"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </RelativeLayout>

            <ListView
                android:id="@+id/upgradeList"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:divider="@color/panel_line"
                android:dividerHeight="1dp"
                android:listSelector="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom bar: 4 ImageButtons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/soot"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tabDefense"
            style="@style/TabButton"
            android:contentDescription="@string/tab_defense"
            android:src="@drawable/ic_tab_defense" />

        <ImageButton
            android:id="@+id/tabSupplies"
            style="@style/TabButton"
            android:contentDescription="@string/tab_supplies"
            android:src="@drawable/ic_tab_supplies" />

        <ImageButton
            android:id="@+id/tabAutomation"
            style="@style/TabButton"
            android:contentDescription="@string/tab_automation"
            android:src="@drawable/ic_tab_automation" />

        <ImageButton
            android:id="@+id/tabSurvivors"
            style="@style/TabButton"
            android:contentDescription="@string/tab_survivors"
            android:src="@drawable/ic_tab_survivors" />
    </LinearLayout>
</LinearLayout>
