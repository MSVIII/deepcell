<?xml version="1.0" encoding="utf-8"?>
<!-- Survivor roster: header, list (tap to change job), recruit row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_hud"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/survivorsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/survivorsTitle"
            style="@style/BunkerHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/survivorsBack"
            android:layout_toStartOf="@id/survivorsFoodChip"
            android:ellipsize="end"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/survivorsFoodChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/np_label"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/food"
                android:src="@drawable/icon_food" />

            <TextView
                android:id="@+id/survivorsFood"
                style="@style/HudNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </RelativeLayout>

    <ListView
        android:id="@+id/survivorList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        android:background="@drawable/np_panel"
        android:divider="#338FA3B0"
        android:dividerHeight="1dp"
        android:padding="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tabbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/recruitName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="name"
            android:background="@drawable/np_field"
            android:hint="@string/recruit_name_hint"
            android:inputType="textCapWords"
            android:maxLength="16"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_dim" />

        <Button
            android:id="@+id/recruitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:drawableEnd="@drawable/ic_food"
            android:drawablePadding="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp" />
    </LinearLayout>
</LinearLayout>
