<?xml version="1.0" encoding="utf-8"?>
<!--
    One underground room: lift shaft with floor number on the left, the rendered room on the
    right. Tap anywhere in the room to work it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/room_height"
    android:descendantFocusability="blocksDescendants"
    android:orientation="horizontal">

    <!-- Lift shaft segment. -->
    <FrameLayout
        android:layout_width="@dimen/shaft_width"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/shaft" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/np_cell_frame" />

        <TextView
            android:id="@+id/floorNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/np_plaque"
            android:fontFamily="@font/barlow"
            android:gravity="center"
            android:textColor="@color/text_on_amber"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- The room. -->
    <FrameLayout
        android:id="@+id/room"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/roomArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Warm lamp light that breathes slowly. -->
        <View
            android:id="@+id/roomGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lamp_glow" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_room_shade" />

        <!-- Black cell frame with an inner shadow: each room reads as its own box. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/np_cell_frame" />

        <!-- Survivors working here are added in code. -->
        <LinearLayout
            android:id="@+id/roomWorkers"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <!-- Room name. -->
        <TextView
            android:id="@+id/roomName"
            style="@style/SceneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp" />

        <!-- Payout per full bar. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/np_label"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/roomGear"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/automated"
                android:src="@drawable/icon_gear"
                android:visibility="gone" />

            <TextView
                android:id="@+id/roomYield"
                style="@style/SceneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/roomYieldIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- "+5" when the bar fills. -->
        <TextView
            android:id="@+id/roomPopup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/barlow"
            android:shadowColor="#FF000000"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@color/amber"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <ProgressBar
            android:id="@+id/floorProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp"
            android:progressDrawable="@drawable/progress_floor" />
    </FrameLayout>
</LinearLayout>
