<?xml version="1.0" encoding="utf-8"?>
<!--
    Title screen: camera shots of the bunker that pan slowly and blur across to the next
    (ui/TitleSlideshow), drifting dust and passing drones on top (ui/TitleAmbience), the
    rendered logo, then the menu: Continue (with the save), New Game, Settings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The stage pans; it holds the sharp shot and its blurred copy. -->
    <FrameLayout
        android:id="@+id/titleStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/titleShot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/titleShotBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="invisible" />
    </FrameLayout>

    <View
        android:id="@+id/titleVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="invisible" />

    <!-- Moving layer: dust motes and drones (added in code). -->
    <FrameLayout
        android:id="@+id/titleFx"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_vignette" />

    <!-- Darkens the top so the logo reads over bright shots. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_title_shade" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="300dp"
        android:layout_height="210dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/np_panel"
        android:orientation="vertical">

        <!-- The saved bunker: name, wave, resources, crew. Hidden when there is no save. -->
        <LinearLayout
            android:id="@+id/saveCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/np_label"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/saveName"
                style="@style/BunkerHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/saveWave"
                    style="@style/SceneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_scrap" />

                <TextView
                    android:id="@+id/saveScrap"
                    style="@style/SceneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="10dp"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_food" />

                <TextView
                    android:id="@+id/saveFood"
                    style="@style/SceneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="10dp"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_tab_survivors" />

                <TextView
                    android:id="@+id/saveCrew"
                    style="@style/SceneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_game" />

        <Button
            android:id="@+id/newGameButton"
            style="@style/BunkerButton.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/new_game" />

        <Button
            android:id="@+id/menuSettingsButton"
            style="@style/BunkerButton.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings" />
    </LinearLayout>
</FrameLayout>
