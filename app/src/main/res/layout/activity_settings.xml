<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: a TableLayout card for the controls (Module 6), Share, and Reset save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_hud">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/BunkerHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/settingsBack"
            android:text="@string/settings" />
    </RelativeLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/np_panel"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:stretchColumns="0">

        <TableRow
            android:gravity="center_vertical"
            android:minHeight="60dp">

            <TextView
                style="@style/BunkerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sound" />

            <Switch
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" />
        </TableRow>

        <View
            android:layout_height="1dp"
            android:background="#338FA3B0" />

        <TableRow
            android:gravity="center_vertical"
            android:minHeight="60dp">

            <TextView
                style="@style/BunkerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty" />

            <Spinner
                android:id="@+id/difficultySpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/shareButton"
        style="@style/BunkerButton.Dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/share" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/np_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <CheckBox
            android:id="@+id/resetConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_confirm"
            android:textColor="@color/text_main" />

        <Button
            android:id="@+id/resetButton"
            style="@style/BunkerButton.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reset_save" />
    </LinearLayout>
</LinearLayout>
