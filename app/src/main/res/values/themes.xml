<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One dark theme for the whole app. No action bar: each screen draws its own header. -->
    <style name="Theme.BurrowNine" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/rust</item>
        <item name="colorPrimaryDark">@color/soot</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/bunker_wall</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">@color/soot</item>
    </style>

    <!-- Reusable text styles (Module 4: styles). -->
    <style name="BunkerTitle">
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="BunkerHeading">
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="BunkerText">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BunkerSmall">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TabButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
