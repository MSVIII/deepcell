<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One dark theme for the whole app. No action bar: each screen draws its own header. -->
    <style name="Theme.Deepcell" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/rust</item>
        <item name="colorPrimaryDark">@color/soot</item>
        <item name="colorAccent">@color/amber</item>
        <item name="colorControlNormal">@color/text_dim</item>
        <item name="android:windowBackground">@color/slate</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">#FF0B0D10</item>
        <item name="buttonStyle">@style/BunkerButton</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <!-- Buttons (Module 4: styles). Amber is the main action; Dark and Danger are variants. -->
    <style name="BunkerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BunkerButton.Dark">
        <item name="android:background">@drawable/bg_button_dark</item>
    </style>

    <style name="BunkerButton.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <!-- Text styles. -->

    <style name="BunkerHeading">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/barlow</item>
    </style>

    <style name="BunkerText">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/barlow</item>
    </style>

    <style name="BunkerSmall">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/barlow</item>
    </style>

    <style name="HudNumber">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:shadowColor">#FF000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <!-- Room name and small labels over the art. -->
    <style name="SceneLabel">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:shadowColor">#FF000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="TabButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
