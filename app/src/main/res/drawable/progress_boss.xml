<?xml version="1.0" encoding="utf-8"?>
<!-- Boss health bar: dark track, bright red fill with a lighter top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="2dp" /><solid android:color="#E60B0D10" /><stroke android:width="1dp" android:color="#99D23C2F" /></shape>
    </item>
    <item android:id="@android:id/progress" android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <clip>
            <shape>
                <corners android:radius="2dp" />
                <gradient android:angle="270" android:startColor="#FFFF6A4D" android:endColor="#FFB52A1F" />
            </shape>
        </clip>
    </item>
</layer-list>
