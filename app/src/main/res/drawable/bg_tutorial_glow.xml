<?xml version="1.0" encoding="utf-8"?>
<!-- Tutorial highlight: a glowing amber frame (soft wide halo, brighter ring, pale core line). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="6dp" android:color="#40FFC24D" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke android:width="4dp" android:color="#80FFC24D" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="2.5dp" android:color="#FFFFE6A0" />
            <solid android:color="#14FFD27A" />
        </shape>
    </item>
</layer-list>
