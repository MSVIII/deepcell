<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: a steel plate. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="0dp"><shape><solid android:color="#FF26241F" /><corners android:radius="6dp" /></shape></item>
            <item android:top="0dp" android:bottom="4dp"><shape><solid android:color="#FF34322E" /><corners android:radius="6dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp"><shape><solid android:color="#FF2A2824" /><corners android:radius="6dp" /></shape></item>
            <item android:top="1dp" android:bottom="1dp"><shape><solid android:color="@color/steel_dark" /><corners android:radius="6dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="0dp"><shape><solid android:color="#FF2A2824" /><corners android:radius="6dp" /></shape></item>
            <item android:top="0dp" android:bottom="4dp"><shape><solid android:color="#FF4A4741" /><corners android:radius="6dp" /></shape></item>
        </layer-list>
    </item>
</selector>
